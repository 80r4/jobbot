# Copy to .env and fill in. Never commit .env.

# Your domain (for HTTPS via Caddy)
DOMAIN=jobs.example.com

# Dashboard login (required — the dashboard is on the public internet)
DASHBOARD_USER=b
DASHBOARD_PASS=change-me-to-something-long

# Adzuna API — free at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Telegram alerts (optional) — create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# Cover-letter drafts (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
