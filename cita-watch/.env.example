# Copy to .env and fill in. Never commit .env.

# Your domain — point its DNS A record at this server first
DOMAIN=cita.example.com

# Login for the panel. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-long-password'
# Keep the single quotes: the hash contains $ signs.
CITA_USER=me
CITA_PASS_HASH='$2a$14$replace.with.your.hash'
